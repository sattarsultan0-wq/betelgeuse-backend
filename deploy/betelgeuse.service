[Unit]
Description=Betelgeuse API
After=network.target postgresql.service

[Service]
Type=simple
User=betelgeuse
WorkingDirectory=/opt/betelgeuse/backend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/betelgeuse/backend/uploads

[Install]
WantedBy=multi-user.target
