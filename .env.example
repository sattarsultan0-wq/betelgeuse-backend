NODE_ENV=development
PORT=4000
# Local development; keep both URLs on the same local database.
DATABASE_URL=postgresql://betelgeuse:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/betelgeuse?schema=public
DIRECT_URL=postgresql://betelgeuse:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/betelgeuse?schema=public
# Supabase: replace the two URLs above with the exact strings from Connect.
# Application, transaction pooler:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?schema=public&pgbouncer=true&sslmode=require
# Migrations, session pooler (or direct connection when IPv6 is available):
# DIRECT_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?schema=public&sslmode=require
JWT_SECRET=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_URL=http://127.0.0.1:5173
# Render production:
# NODE_ENV=production
# CORS_ORIGINS=https://betelgeuse-ai.vercel.app
# FRONTEND_URL=https://betelgeuse-ai.vercel.app
# COOKIE_CROSS_SITE=true
# TRUST_PROXY=1
# Production: true for Vercel + API on a different site; requires HTTPS
COOKIE_CROSS_SITE=false
# Render or Lightsail behind one trusted proxy: set 1; local: 0
TRUST_PROXY=0
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# Higgsfield uses Authorization: Key KEY_ID:KEY_SECRET; keep the existing names above.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=betelgeuse-uploads
# Input GET links start when the worker submits, not when the photo is uploaded.
# 24 hours; increase for longer provider queues (max 604800 seconds).
R2_INPUT_URL_TTL_SECONDS=86400
# Explicit enable after reviewing model docs and provider balance
HIGGSFIELD_ENABLED=false
# Never automatically grant paid credits to registrations
REGISTRATION_QUOTA=0
MAX_ACTIVE_GENERATIONS=2
WORKER_INTERVAL_MS=5000
GENERATION_TIMEOUT_MS=1200000
TELEGRAM_BOT_TOKEN=
# Social sign-in: server-side only; register the exact callback URL with each provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/auth/oauth/google/callback
# Render: set GOOGLE_REDIRECT_URI to the REAL_BACKEND_ORIGIN + /api/auth/oauth/google/callback.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 private key as a quoted PEM string; literal \n is supported
APPLE_PRIVATE_KEY=
# Apple requires a registered public HTTPS domain; localhost/IP are not supported
APPLE_REDIRECT_URI=
# Exact hosts permitted for provider upload and result URLs; review account response
PROVIDER_MEDIA_HOSTS=images.higgs.ai,videos.higgs.ai,cdn.higgsfield.ai
